# Copy to `.env.local` and fill in. Everything here is optional — the site
# builds and runs without any of it, degrading to the contact form and
# phone/email instead of online booking.

# Public origin. Drives canonical URLs, the sitemap, robots.txt and OG images.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Calendly -----------------------------------------------------------------
# Leave unset to hide the booking flow entirely and fall back to the
# consultation form. Setting this one variable is enough to switch booking on.
NEXT_PUBLIC_CALENDLY_URL=

# Optional per-event overrides. Each falls back to NEXT_PUBLIC_CALENDLY_URL, so
# they can be added one at a time as the event types are created.
# NEXT_PUBLIC_CALENDLY_URL_SITE_SURVEY=
# NEXT_PUBLIC_CALENDLY_URL_AMC=
# NEXT_PUBLIC_CALENDLY_URL_SECURITY=
# NEXT_PUBLIC_CALENDLY_URL_CABLING=
