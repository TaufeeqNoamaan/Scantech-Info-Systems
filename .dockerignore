# Build context only. Smaller context means a faster upload to Cloud Build and
# fewer layers to invalidate.

# Dependencies and build output are produced inside the image, never copied in.
# `node_modules` is the important one: the host tree contains Windows-native
# binaries for sharp, and letting it through would silently ship a Linux image
# with an unusable image optimiser.
node_modules
.next
out
build

# Version control
.git
.gitignore

# Scratch: extracted legacy content used as copy source material
.scan

# Editor and OS noise
.vscode
.idea
.DS_Store
Thumbs.db

# Secrets — never enter the build context
.env
.env.*
!.env.example

# Container files themselves
Dockerfile
.dockerignore
docker-compose*.yml

# Logs and caches
*.log
npm-debug.log*
.eslintcache
*.tsbuildinfo

# Design and process documents — not needed to build or run the site
ROADMAP.md
DESIGN.md
code.html
screen.png
README.md
